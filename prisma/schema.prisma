generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "postgresql"
}


model Admin {
  uid        String @id @default(uuid())
  firstName  String
  lastName   String
  email      String @unique
  password   String
}

model Patient {
  uid         String @id @default(uuid())
  firstName   String
  lastName    String
  email       String @unique
  password    String
  dob         DateTime
  height      Int
  weight      Int
  bloodGroup  String

  appointments Appointment[]
}

model Doctor {
  uid             String @id @default(uuid())
  firstName       String
  lastName        String
  email           String @unique
  password        String
  experience      Int
  specialization  String

  appointments Appointment[]
}


model Appointment {
  uid              String @id @default(uuid())
  appointmentDate  DateTime
  appointmentTime  String
  status           AppointmentStatus

  patientId String
  doctorId  String

  patient Patient @relation(fields: [patientId], references: [uid])
  doctor Doctor @relation(fields: [doctorId], references: [uid])
}

enum AppointmentStatus {
  BOOKED 
  CANCELLED
}